# URL pública onde o sistema vai ficar publicado (sem barra no final)
# Em desenvolvimento local: http://localhost:3000
# Em produção: https://seu-projeto.vercel.app  (ou seu domínio próprio)
APP_URL=http://localhost:3000

# Nome/empresa exibido nos formulários e e-mails
COMPANY_NAME="SICtv - Afiliada Record"

# --- Banco de dados (Upstash Redis) ---
# Crie gratuitamente em https://upstash.com (ou pela integração Upstash dentro da Vercel)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- E-mail (Resend) ---
# Crie gratuitamente em https://resend.com
RESEND_API_KEY=
# Remetente dos e-mails. Use um domínio verificado no Resend, ex: "Adiantamento de Viagem <adiantamento@suaempresa.com>"
EMAIL_FROM="Adiantamento de Viagem <onboarding@resend.dev>"

# E-mail fixo do setor Financeiro (recebe a etapa final de aprovação)
FINANCE_EMAIL=financeiro@suaempresa.com

# --- Segurança ---
# String aleatória e secreta usada para assinar os links de aprovação. Gere uma nova para produção.
TOKEN_SECRET=troque-este-valor-por-uma-string-aleatoria-longa

# Senha de acesso ao painel administrativo (/painel)
ADMIN_PASSWORD=troque-esta-senha
